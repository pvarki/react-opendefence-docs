              "height": 2556
            }
          ]
        },
        {
          "title": "Konfigurerad och karta i bruk",
          "layout": "image-left",
          "html": "<ul>\n<li>Konfigurationen är nu klar och kartvyn är också i bruk.</li>\n</ul>",
