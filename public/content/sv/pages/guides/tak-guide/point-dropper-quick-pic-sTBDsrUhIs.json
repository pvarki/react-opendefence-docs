        },
        {
          "title": "Byt namn på bilden",
          "layout": "image-bottom",
          "html": "<ul>\n<li>Genom att trycka på <strong>Edit Name icon</strong> kan du byta namn på bilden.</li>\n</ul>",
          "images": [
            {
              "src": "/content/images/sv/attachments/6c2f87cd6f97b770.webp",
              "width": 2340,
              "height": 1080
            }
