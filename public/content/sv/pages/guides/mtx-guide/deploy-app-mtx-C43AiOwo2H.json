        {
          "title": "MTX-sidan – Titta på ström Grundläggande",
          "layout": "image-left",
          "html": "<ul>\n<li>Strömmen öppnas i webbläsaren och börjar spelas automatiskt</li>\n</ul>",
          "images": [
            {
              "src": "/content/images/sv/attachments/57fae925d2f171e7.webp",
              "width": 1080,
              "height": 2002
            }
