  "blocks": [
    {
      "type": "html",
      "html": "<p>Turn on arrows that point to nearby markers sitting just off the edge of your map view, so you know what is around you without zooming out.</p>"
    },
    {
      "type": "slideset",
      "source": "canonical",
      "slides": [
        {
          "title": "Open Other Overlays",
          "layout": "image-bottom",
          "html": "<p>Open <strong>Overlay Manager</strong>, then tap <strong>Other Overlays</strong>. Each row has an eye icon you tap to enable or disable that overlay.</p>",
          "images": [
            {
              "src": "/content/images/en/attachments/f28caa1685cb737c.webp",
              "width": 400,
              "height": 191
            }
          ]
        },
        {
          "title": "Toggle Off-Screen Indicators",
          "layout": "image-bottom",
          "html": "<p>Tap the eye icon on the <strong>Off-Screen Indicators</strong> row to turn it on. Arrows then appear at the map edge pointing to newly placed or received markers that are nearby but outside your current view (how near depends on zoom level).</p>",
          "images": [
            {
              "src": "/content/images/en/attachments/d6879fdc07334ec1.webp",
              "width": 400,
              "height": 194
            }
          ]
