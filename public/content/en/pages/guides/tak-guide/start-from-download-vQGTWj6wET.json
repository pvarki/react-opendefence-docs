  "blocks": [
    {
      "type": "html",
      "html": "<h2 id=\"install-and-open-itak-for-initialization\"><a href=\"#install-and-open-itak-for-initialization\">Install and open iTAK for initialization</a></h2>"
    },
    {
      "type": "slideset",
      "source": "legacy",
      "slides": [
        {
          "title": "Install iTAK from the Appstore",
          "layout": "text",
          "html": "<ul>\n<li><a href=\"https://apps.apple.com/us/app/itak/id1561656396\" target=\"_blank\" rel=\"noopener noreferrer\">https://apps.apple.com/us/app/itak/id1561656396</a></li>\n</ul>",
          "images": []
        },
        {
          "title": "Open iTAK App",
          "layout": "image-left",
          "html": "<ul>\n<li>Find the iTAK icon and start the App. Don't allow app to find other devices on local network. iTAK doesen't encrypt traffic in a LAN.</li>\n</ul>",
          "images": [
            {
              "src": "/content/images/en/attachments/d2b86a0e4da37de8.webp",
              "width": 1179,
              "height": 2556
            }
          ]
        },
        {
          "title": "Start Setup iTAK flow",
          "layout": "image-left",
          "html": "<ul>\n<li>Start Setup iTAK flow.</li>\n</ul>",
          "images": [
            {
              "src": "/content/images/en/attachments/4bc489751e28b47d.webp",
              "width": 1179,
              "height": 2556
            }
          ]
        },
        {
          "title": "Callsign Settings",
          "layout": "image-left",
          "html": "<ul>\n<li>Give your Callsign in the Callsign field, Leave Phone field empty.</li>\n</ul>",
          "images": [
            {
              "src": "/content/images/en/attachments/179742443855f7bd.webp",
              "width": 1179,
              "height": 2556
            }
          ]
        },
        {
          "title": "Team/Role Settings",
          "layout": "image-left",
          "html": "<ul>\n<li>Choose your Team and Role.</li>\n<li>Team color should have been told to you. Default role is Team Member</li>\n</ul>",
          "images": [
            {
              "src": "/content/images/en/attachments/25a884ed6dc00676.webp",
              "width": 1179,
              "height": 2556
            }
          ]
        },
        {
          "title": "Privacy Settings",
          "layout": "image-left",
          "html": "<ul>\n<li>Activate Notifications and Location Services</li>\n<li>NOTICE! Approve all iTAK notification sending and location usage questions.</li>\n<li>IMPORTANT! Allow location usage also when you are not using the app.</li>\n</ul>",
          "images": [
            {
              "src": "/content/images/en/attachments/60c55560970d34f8.webp",
              "width": 1179,
              "height": 2556
            }
          ]
        },
        {
          "title": "iTAK Opens / Remaining steps",
          "layout": "text",
          "html": "<ol>\n<li>Settings/ Unit Preferences</li>\n<li>Server connection / Package import</li>\n<li>Datasync activation</li>\n<li>Map settings</li>\n</ol>",
          "images": []
        },
        {
          "title": "iTAK Settings",
