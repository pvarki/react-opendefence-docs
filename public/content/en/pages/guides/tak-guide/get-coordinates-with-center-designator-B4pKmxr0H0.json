      "slides": [
        {
          "title": "Enable Center Designator",
          "layout": "image-bottom",
          "html": "<p>Open <strong>Overlay Manager</strong>, then <strong>Other Overlays</strong>. Tap the eye icon next to <strong>Center Designator</strong> to turn it on.</p>",
          "images": [
            {
