              "width": 1179,
              "height": 2556
            }
          ]
        },
        {
          "title": "Allow location backround tracking",
          "layout": "image-left",
          "html": "<ul>\n<li>Choose <em>Change to Always Allow</em></li>\n</ul>",
          "images": [
