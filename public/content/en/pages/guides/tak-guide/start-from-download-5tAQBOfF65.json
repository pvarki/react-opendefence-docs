        {
          "title": "Install iTAK from the App Store",
          "layout": "text",
          "html": "<ul>\n<li><a href=\"https://apps.apple.com/fi/app/tak-tracker/id6455684671\" target=\"_blank\" rel=\"noopener noreferrer\">https://apps.apple.com/fi/app/tak-tracker/id6455684671</a></li>\n</ul>",
          "images": []
        },
        {
          "title": "Open TAK Tracker App",
          "layout": "image-left",
          "html": "<ul>\n<li>Find the TAK Tracker icon and start the App. Don't allow app to find other devices on local network. TAK Tracker doesen't encrypt traffic in a LAN.</li>\n</ul>",
          "images": [
            {
              "src": "/content/images/en/attachments/228e60492645f7cd.webp",
              "width": 1179,
              "height": 2556
            }
          ]
        },
        {
          "title": "Location Permissions",
          "layout": "image-left",
          "html": "<ul>\n<li>Push <em>Set Location Permissions</em> button</li>\n</ul>",
          "images": [
            {
              "src": "/content/images/en/attachments/7b4ff26a8d55ecec.webp",
              "width": 1179,
              "height": 2556
            }
          ]
        },
        {
          "title": "Allow location tracking",
          "layout": "image-left",
          "html": "<ul>\n<li>Choose <em>Allow While Using App</em></li>\n</ul>",
          "images": [
            {
              "src": "/content/images/en/attachments/cfd721cf5ce2840e.webp",
              "width": 1179,
              "height": 2556
            }
          ]
        },
        {
          "title": "Location backround tracking",
          "layout": "image-left",
          "html": "<ul>\n<li>Push <em>Enable Backround Tracking</em> button</li>\n</ul>",
