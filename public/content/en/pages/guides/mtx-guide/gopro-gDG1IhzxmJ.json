      "text": "GoPro Streaming with GoPro Quick app",
      "id": "gopro-streaming-with-gopro-quick-app"
    }
  ],
  "blocks": [
    {
      "type": "html",
      "html": "<h2 id=\"gopro-streaming-with-gopro-quick-app\"><a href=\"#gopro-streaming-with-gopro-quick-app\">GoPro Streaming with GoPro Quick app</a></h2>"
    },
    {
      "type": "slideset",
      "source": "legacy",
      "slides": [
        {
          "title": "Open GoPro Quick App",
          "layout": "image-left",
          "html": "<ul>\n<li>Connect to your GoPro</li>\n<li>Go to <strong>GoPro</strong> - Bottom menu</li>\n<li>Go to <strong>GoPro Settings</strong></li>\n</ul>",
          "images": [
            {
              "src": "/content/images/en/attachments/be731519f338ca01.webp",
              "width": 1080,
              "height": 2107
            }
          ]
        },
        {
          "title": "GoPro Settings",
          "layout": "image-left",
          "html": "<ul>\n<li>Go to <strong>Live Stream</strong></li>\n</ul>",
          "images": [
            {
              "src": "/content/images/en/attachments/655af611889d3dea.webp",
              "width": 1080,
              "height": 2107
            }
          ]
        },
        {
          "title": "Set Up Live",
          "layout": "image-left",
          "html": "<ul>\n<li>Go to <strong>Other/RTMP</strong></li>\n</ul>",
          "images": [
            {
              "src": "/content/images/en/attachments/362dbd9e09f7c19b.webp",
              "width": 1080,
              "height": 2107
            }
          ]
        },
        {
          "title": "Stream to Other/RTMP 1",
          "layout": "image-left",
          "html": "<ul>\n<li>Connect to Wi-Fi Network - <strong>Select a Wi-Fi Network</strong></li>\n<li>Fill the RTMPS URL from MTX - <strong>Enter your RTMP URL</strong></li>\n</ul>",
          "images": [
            {
              "src": "/content/images/en/attachments/2501089abd2c3fe6.webp",
              "width": 1080,
              "height": 2107
            }
          ]
        },
        {
          "title": "Stream to Other/RTMP 2",
          "layout": "image-left",
          "html": "<ul>\n<li>Check Wi-Fi Connection</li>\n<li>Check Stream URL</li>\n<li>Check Resolution</li>\n<li>Go to <strong>Continue</strong></li>\n</ul>",
          "images": [
            {
              "src": "/content/images/en/attachments/9642a60ab2fb99d5.webp",
              "width": 1080,
              "height": 2107
            }
          ]
        },
        {
          "title": "Go Live",
          "layout": "image-left",
          "html": "<ul>\n<li>Wait for the connection to establish</li>\n<li>Go to <strong>Go Live</strong></li>\n</ul>",
          "images": [
            {
              "src": "/content/images/en/attachments/8865398b3a5be967.webp",
              "width": 1080,
              "height": 2107
            }
          ]
        },
        {
          "title": "Streaming Live",
          "layout": "image-left",
          "html": "<ul>\n<li>Streaming live</li>\n<li>When done with stream quit with <strong>Stop Button</strong></li>\n</ul>",
          "images": [
            {
              "src": "/content/images/en/attachments/8665eaf7f1f838f3.webp",
              "width": 1080,
              "height": 2107
            }
          ]
        }
      ]
    },
    {
      "type": "html",
      "html": "<p>After successfully streaming, continue to <a href=\"/doc/9c3d844b-ebb7-453c-9d30-7bab0891f66e\">Watch Stream</a></p>"
    }
  ]
