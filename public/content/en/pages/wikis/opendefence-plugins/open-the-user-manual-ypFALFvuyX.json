        },
        {
          "title": "Open ATAK's Settings",
          "layout": "image-bottom",
          "html": "<p>Tap <strong>Tool Preferences</strong>.</p>",
          "images": [
            {
              "src": "/content/images/en/attachments/3b1f1b37f8eddfba.webp",
              "width": 1336,
              "height": 2660
            }
          ]
        },
        {
          "title": "Find the plugins' settings",
          "layout": "image-bottom",
          "html": "<p>Tap <strong>Specific Tool Preferences</strong>.</p>",
          "images": [
            {
              "src": "/content/images/en/attachments/951d5f6a145433bf.webp",
              "width": 1336,
              "height": 2660
            }
          ]
        },
        {
          "title": "Pick OD UAVOps",
          "layout": "image-bottom",
          "html": "<p>Scroll down to the OD pages, one for each OpenDefence plugin. Tap <strong>OD UAVOps Preferences</strong>.</p>",
