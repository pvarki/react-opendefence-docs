            }
          ]
        },
        {
          "title": "Tap a route",
          "layout": "image-bottom",
          "html": "<p>Tap a route or a drone for ATAK's own menu and details. If ATAK lists several items, tap the route's name.</p>",
          "images": [
            {
              "src": "/content/images/en/attachments/6b81f52749c15e8d.webp",
              "width": 1336,
