        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MTXAuthReq": {
        "properties": {
          "user": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User",
            "description": "Username, may be empty if user is not provided yet"
          },
          "password": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Password",
            "description": "Password, may be empty if user+password is not provided yet"
          },
          "ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip",
            "description": "IP address of the client from MediaMTX PoV"
          },
          "action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action",
            "description": "Action user wants to take"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path",
            "description": "Path user wants to use"
          },
          "protocol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Protocol",
            "description": "Protocol user wants to use"
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id",
            "description": "FIXME: Figure out what this actually means"
          },
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query",
            "description": "FIXME: Figure out what this actually means"
          }
        },
        "type": "object",
        "title": "MTXAuthReq",
        "description": "https://github.com/bluenviron/mediamtx?tab=readme-ov-file#http-based\n{\n  \"user\": \"user\",\n  \"password\": \"password\",  # pragma: allowlist secret\n  \"ip\": \"ip\",\n  \"action\": \"publish|read|playback|api|metrics|pprof\",\n  \"path\": \"path\",\n  \"protocol\": \"rtsp|rtmp|hls|webrtc|srt\",\n  \"id\": \"id\",\n  \"query\": \"query\"\n}"
      },
      "OperationResultResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "Was the operation a success, used in addition to http status code"
          },
          "extra": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extra",
            "description": "Extra information",
            "nullable": true
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error",
            "description": "Error message if any",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "success"
        ],
        "title": "OperationResultResponse",
        "description": "Communicate result of operation",
        "examples": [
          {
            "success": true
          },
          {
            "error": "Things went wrong",
            "success": false
          },
          {
            "extra": "Tell the user they're awesome",
            "success": true
          }
        ]
      },
      "ProductAddRequest": {
        "properties": {
          "certcn": {
            "type": "string",
            "title": "Certcn",
            "description": "CN of the certificate"
          },
          "x509cert": {
            "type": "string",
            "title": "X509Cert",
            "description": "Certificate encoded with CFSSL conventions (newlines escaped)"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "certcn",
          "x509cert"
        ],
        "title": "ProductAddRequest",
        "description": "Request to add product interoperability.",
        "examples": [
          {
            "certcn": "product.deployment.tld",
            "x509cert": "-----BEGIN CERTIFICATE-----\\nMIIEwjCC...\\n-----END CERTIFICATE-----\\n"
          }
        ]
      },
      "ProductAuthzResponse": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "type of authz: bearer-token, basic, mtls"
          },
          "token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Token",
            "description": "Bearer token"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username",
            "description": "Username for basic auth"
          },
          "password": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Password",
            "description": "Password for basic auth"
          },
          "ro_password": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
