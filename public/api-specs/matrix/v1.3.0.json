  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OperationResultResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "Was the operation a success, used in addition to http status code"
          },
          "extra": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extra",
            "description": "Extra information",
            "nullable": true
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error",
            "description": "Error message if any",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "success"
        ],
        "title": "OperationResultResponse",
        "description": "Communicate result of operation",
        "examples": [
          {
            "success": true
          },
          {
            "error": "Things went wrong",
            "success": false
          },
          {
            "extra": "Tell the user they're awesome",
            "success": true
          }
        ]
      },
      "ProductComponent": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "link",
              "markdown",
              "component"
            ],
            "title": "Type"
          },
          "ref": {
            "type": "string",
            "title": "Ref"
          }
        },
        "type": "object",
        "required": [
          "type",
          "ref"
        ],
        "title": "ProductComponent",
        "description": "Project component info"
      },
      "ProductDescription": {
        "properties": {
          "shortname": {
            "type": "string",
            "title": "Shortname",
            "description": "Short name for the product, used as slug/key in dicts and urls"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Fancy name for the product"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Icon",
            "description": "URL for icon"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Short-ish description of the product"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "description": "Language of this response"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "shortname",
          "title",
          "icon",
          "description",
          "language"
        ],
        "title": "ProductDescription",
        "description": "Description of a product"
      },
      "ProductDescriptionExtended": {
        "properties": {
          "shortname": {
            "type": "string",
            "title": "Shortname",
            "description": "Short name for the product, used as slug/key in dicts and urls"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Fancy name for the product"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Icon",
            "description": "URL for icon"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Short-ish description of the product"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "description": "Language of this response"
          },
          "docs": {
            "type": "string",
            "title": "Docs",
            "description": "Link to documentation"
          },
          "component": {
            "$ref": "#/components/schemas/ProductComponent",
            "description": "Component type and ref"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "shortname",
          "title",
          "icon",
          "description",
          "language",
          "docs",
          "component"
        ],
        "title": "ProductDescriptionExtended",
        "description": "Description of a product"
      },
      "ProductHealthCheckResponse": {
        "properties": {
          "healthy": {
            "type": "boolean",
            "title": "Healthy",
            "description": "Everything is good, ready to serve"
          },
          "extra": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extra",
            "description": "Extra information",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "healthy"
        ],
        "title": "ProductHealthCheckResponse",
        "description": "Healthcheck response for product integration apis\n\nThe extra info might be used by a human to debug things but RASENMAEHER will not use it",
        "examples": [
          {
            "healthy": true
          },
          {
            "extra": "Things went wrong",
            "healthy": false
          }
        ]
      },
      "UserCRUDRequest": {
        "properties": {
          "uuid": {
            "type": "string",
            "title": "Uuid",
            "description": "RASENMAEHER UUID for this user"
          },
          "callsign": {
            "type": "string",
            "title": "Callsign",
            "description": "Callsign of the user"
          },
          "x509cert": {
            "type": "string",
            "title": "X509Cert",
            "description": "Certificate encoded with CFSSL conventions (newlines escaped)"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "uuid",
          "callsign",
          "x509cert"
        ],
        "title": "UserCRUDRequest",
        "description": "Request to create user",
        "examples": [
          {
            "callsign": "ROTTA01a",
            "uuid": "3ede23ae-eff2-4aa8-b7ef-7fac68c39988",
            "x509cert": "-----BEGIN CERTIFICATE-----\\nMIIEwjCC...\\n-----END CERTIFICATE-----\\n"
          }
        ]
      },
      "UserInstructionFragment": {
        "properties": {
          "html": {
            "type": "string",
            "title": "Html",
            "description": "The HTML content will be shown for this products instructions"
          },
          "inject_css": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Inject Css",
            "description": "If extra stylesheet is needed, set the fully qualified URI",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "html"
        ],
        "title": "UserInstructionFragment",
        "description": "Product instructions for user",
        "examples": [
          {
            "html": "<p>Hello World!</p>"
          },
          {
            "html": "<p class=\"hello\">Hello World!</p>",
            "inject_css": "http://example.com/mystyle.css"
          }
        ]
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "MTLSHeader": {
        "type": "http",
        "scheme": "header"
      }
    }
  }
}
