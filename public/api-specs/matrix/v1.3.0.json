    "/api/v1/clients/fragment": {
      "post": {
        "tags": [
          "clients"
        ],
        "summary": "Client Instruction Fragment",
        "description": "Return user instructions, we use POST because the integration layer might not keep\ntrack of callsigns and certs by UUID and will probably need both for the instructions",
        "operationId": "client_instruction_fragment_api_v1_clients_fragment_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCRUDRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response Client Instruction Fragment Api V1 Clients Fragment Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "deprecated": true,
        "security": [
          {
            "MTLSHeader": []
          }
        ]
      }
    },
