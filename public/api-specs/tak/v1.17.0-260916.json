        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "Was the operation a success, used in addition to http status code"
          },
          "extra": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extra",
            "description": "Extra information",
            "nullable": true
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error",
            "description": "Error message if any",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "success"
        ],
        "title": "OperationResultResponse",
        "description": "Communicate result of operation",
        "examples": [
          {
            "success": true
          },
          {
            "error": "Things went wrong",
            "success": false
          },
          {
            "extra": "Tell the user they're awesome",
            "success": true
          }
        ]
      },
      "ProductComponent": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "link",
              "markdown",
              "component"
            ],
            "title": "Type"
          },
          "ref": {
            "type": "string",
            "title": "Ref"
          }
        },
        "type": "object",
        "required": [
          "type",
